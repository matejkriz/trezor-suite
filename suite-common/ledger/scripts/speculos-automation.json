{
    "version": 1,
    "rules": [
        {
            "regexp": "^Confirm$|^Sign transaction$|^Approve$|^Accept$",
            "actions": [
                ["button", 1, true],
                ["button", 2, true],
                ["button", 2, false],
                ["button", 1, false]
            ]
        },
        {
            "regexp": "^Verify Bitcoin$|^Address$|^Review transaction$|^Unverified inputs$|^Amount$|^To$|^Fees$",
            "actions": [
                ["button", 2, true],
                ["button", 2, false]
            ]
        }
    ]
}
